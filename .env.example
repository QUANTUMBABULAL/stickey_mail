# ---------------------------------------------------------------------------
# Mail Sticker — environment configuration
#
# Copy this file to `.env` in the project root and fill in the values from a
# Google Cloud OAuth client of type "Desktop app".
#
#   1. https://console.cloud.google.com/  ->  create / pick a project
#   2. APIs & Services -> Library        ->  enable "Gmail API"
#   3. APIs & Services -> OAuth consent screen -> External -> add yourself as
#      a Test user, scope: https://www.googleapis.com/auth/gmail.modify
#   4. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      -> Application type: "Desktop app"
#
# The credentials can also be pasted straight into the app (Settings ->
# Google API credentials). Values found here always take precedence.
#
# In a packaged installation, Mail Sticker also reads a `.env` placed next to
# Mail Sticker.exe or inside %APPDATA%\mail-sticker\.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: file log level — error | warn | info | verbose | debug | silly
MAIL_STICKER_LOG_LEVEL=info

# Optional: open the widget devtools on start (1 to enable)
MAIL_STICKER_DEVTOOLS=0
